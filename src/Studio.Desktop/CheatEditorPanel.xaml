<UserControl x:Class="Studio.Desktop.CheatEditorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid MinHeight="780">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Multi-line cheat editor" Style="{StaticResource Heading}"/>
      <TextBlock Text="Edit a copy of an imported cheat, including every patch line and cave dependency. Nothing is written to the console by editing, saving or exporting. Original files are preserved." Style="{StaticResource Muted}"/>
      <WrapPanel><Button Content="Edit selected library cheat" Command="{Binding OpenEditorCommand}"/><Button Content="New cheat" Command="{Binding NewEditorCommand}"/><Button Content="Open Studio project…" Command="{Binding OpenEditorProjectCommand}"/></WrapPanel>
      <UniformGrid Columns="4" IsEnabled="{Binding IsIdle}">
        <StackPanel><TextBlock Text="Game name"/><TextBox Text="{Binding EditGame, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel><TextBlock Text="CUSA title ID"/><TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel><TextBlock Text="Version (XX.YY)"/><TextBox Text="{Binding EditVersion, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel><TextBlock Text="Process"/><TextBox Text="{Binding EditProcess, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      </UniformGrid>
      <UniformGrid Columns="2" IsEnabled="{Binding IsIdle}">
        <StackPanel><TextBlock Text="Cheat name"/><TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel><TextBlock Text="Description / validation notes"/><TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      </UniformGrid>
      <TextBlock Text="Section is decimal; offsets/bytes are hexadecimal. Dependencies are line IDs, separated by commas. PS5Offset is optional descriptive metadata and never selects a PS4 address." Style="{StaticResource Muted}"/>
    </StackPanel>
    <DataGrid Grid.Row="1" x:Name="PatchLines" ItemsSource="{Binding EditorLines}" SelectedItem="{Binding SelectedEditorLine}" IsReadOnly="False" IsEnabled="{Binding IsIdle}" CanUserAddRows="False" MinHeight="110" HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Line ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
        <DataGridTextColumn Header="Section" Binding="{Binding Section, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
        <DataGridTextColumn Header="Offset (hex)" Binding="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
        <DataGridTextColumn Header="Original bytes" Binding="{Binding Original, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
        <DataGridTextColumn Header="Replacement bytes" Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
        <DataGridTextColumn Header="Dependencies" Binding="{Binding Dependencies, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
        <DataGridCheckBoxColumn Header="Cave" Binding="{Binding IsCave, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
        <DataGridCheckBoxColumn Header="Absolute" Binding="{Binding Absolute, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
        <DataGridTextColumn Header="PS5 metadata" Binding="{Binding Ps5Offset, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2">
      <WrapPanel><CheckBox Content="Instruction / code patch" IsChecked="{Binding InstructionPatch}" IsEnabled="{Binding IsIdle}"/><Button Content="Add patch line" Command="{Binding AddEditorLineCommand}"/><Button Content="Remove selected line" Command="{Binding RemoveEditorLineCommand}"/><Button Content="Validate / disassemble" Command="{Binding ValidateEditorCommand}"/><CheckBox Content="Keep only the edited cheat" IsChecked="{Binding EditorOnlyCheat}"/></WrapPanel>
      <Expander Header="Optional section-base mapping for jump inspection" Foreground="{StaticResource TextBrush}"><StackPanel><TextBlock Text="Only enter independently known original/current bases. Example: 14=400000;18=600000. Without these, cross-section destinations remain unresolved." Style="{StaticResource Muted}"/><TextBox Text="{Binding EditorSectionBases, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Expander>
      <TextBox Text="{Binding EditorStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="95" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
    <TabControl Grid.Row="3" Padding="8">
      <TabItem Header="Disassembly"><DataGrid ItemsSource="{Binding EditorInstructions}"><DataGrid.Columns><DataGridTextColumn Header="Address / section-relative coordinate" Binding="{Binding AddressHex}" Width="185"/><DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="180"/><DataGridTextColumn Header="Line / phase / instruction" Binding="{Binding Assembly}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="Relative jumps &amp; returns"><DataGrid ItemsSource="{Binding EditorJumps}"><DataGrid.Columns><DataGridTextColumn Header="Line" Binding="{Binding PatchId}" Width="85"/><DataGridTextColumn Header="From" Binding="{Binding From}" Width="120"/><DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="120"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="85"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="140"/><DataGridTextColumn Header="Review needed" Binding="{Binding Warning}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
    </TabControl>
    <WrapPanel Grid.Row="4"><Button Content="Save unverified copy to library" Command="{Binding SaveEditorCommand}" Style="{StaticResource Primary}"/><Button Content="Export SHN / JSON…" Command="{Binding ExportEditorCommand}"/><Button Content="Save editable project…" Command="{Binding SaveEditorProjectCommand}"/><Button Content="Review / test edited cheat…" Command="{Binding TestEditorCommand}"/><Button Content="Restore original bytes…" Command="{Binding RollbackCommand}"/></WrapPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
