<Application x:Class="Studio.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ThemeMode="Light" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#182333"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#47576A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
    <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#E7EDF4"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="#B8C5D3"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#17283C"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="CaretBrush" Value="#17283C"/><Setter Property="BorderBrush" Value="#8292A4"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,5,10,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,5,10,10"/><Setter Property="MinWidth" Value="140"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="0,10,15,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#CAD3DF"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="RowBackground" Value="#FFFFFF"/><Setter Property="AlternatingRowBackground" Value="#F6F8FB"/><Setter Property="BorderBrush" Value="#CAD3DF"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="MinHeight" Value="100"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E7EDF4"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="22"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Padding" Value="14,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBox" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,3,0"><ContentPresenter x:Name="HeaderText" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{StaticResource MutedBrush}"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBox" Property="Background" Value="#E7EDF4"/><Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBox" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBox" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="TabBox" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="15"/><Setter Property="Margin" Value="0,12,0,10"/><Setter Property="BorderBrush" Value="#CAD3DF"/></Style>
    <Style x:Key="NavigationItem" TargetType="TabItem">
      <Setter Property="Margin" Value="0,2,12,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent">
              <Grid Height="42" Width="170">
                <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"/>
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="14,0,0,0" HorizontalAlignment="Left"/>
                <ContentPresenter ContentSource="Header" Margin="42,0,8,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#E7EDF4"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#DFEAF8"/>
                <Setter TargetName="Marker" Property="Background" Value="{StaticResource AccentBrush}"/>
                </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
