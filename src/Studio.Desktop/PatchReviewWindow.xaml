<Window x:Class="Studio.Desktop.PatchReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Review exact memory changes" Width="820" Height="570" WindowStartupLocation="CenterOwner" MinWidth="650" MinHeight="450">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Review before writing" Style="{StaticResource Heading}"/>
    <TextBlock x:Name="GameText" Grid.Row="1" Style="{StaticResource Muted}"/>
    <TextBox x:Name="Changes" Grid.Row="2" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <StackPanel Grid.Row="3"><TextBlock Text="A byte match does not prove this cheat is correct. Patching a running game is not atomic and can crash the game or corrupt saves. Back up saves first. Original bytes will be saved locally for rollback." Foreground="#795000" Margin="0,12"/>
    <CheckBox x:Name="Risk" Content="I reviewed these exact changes and accept the risks." Checked="RiskChanged" Unchecked="RiskChanged"/></StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button x:Name="Apply" Content="Write these bytes" IsEnabled="False" Style="{StaticResource Primary}" Click="ApplyClicked"/></StackPanel>
  </Grid>
</Window>
