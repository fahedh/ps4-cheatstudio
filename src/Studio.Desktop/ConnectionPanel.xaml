<UserControl x:Class="Studio.Desktop.ConnectionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="PS4 IP address or hostname"/>
    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" ToolTip="The console's address on your local network"/>
    <UniformGrid Columns="3">
      <StackPanel><TextBlock Text="Debugger TCP"/><TextBox Text="{Binding DebugPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Payload loader TCP"/><TextBox Text="{Binding PayloadPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="FTP TCP"/><TextBox Text="{Binding FtpPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Interrupt TCP"/><TextBox Text="{Binding InterruptPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel><TextBlock Text="Timeout (seconds)"/><TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
    </UniformGrid>
    <CheckBox Content="Use a local simulated console (no PS4 required)" IsChecked="{Binding UseSimulator}"/>
    <TextBlock Text="The payload loader and FTP ports are saved for reference. Connection uses the already running debugger; no payload is injected and no files are sent by FTP." Style="{StaticResource Muted}"/>
    <WrapPanel><Button Content="Connect / test connection" Command="{Binding ConnectCommand}" Style="{StaticResource Primary}"/><Button Content="Disconnect" Command="{Binding DisconnectCommand}"/><Button Content="Save settings" Command="{Binding SaveSettingsCommand}"/></WrapPanel>
  </StackPanel>
</UserControl>
