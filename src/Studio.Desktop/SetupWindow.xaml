<Window x:Class="Studio.Desktop.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Studio.Desktop" Title="Welcome — PS4 GoldHEN Cheat Studio" Width="760" Height="780" MinWidth="600" MinHeight="600" WindowStartupLocation="CenterScreen">
  <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="PS4 / GOLDHEN CHEAT STUDIO" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,24"/>
    <StackPanel Grid.Row="1"><TextBlock Text="{Binding SetupHeading}" Style="{StaticResource Heading}"/><TextBlock Text="{Binding SetupDescription}" Style="{StaticResource Muted}"/></StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="22" Margin="0,12,0,20">
          <StackPanel><TextBlock Text="A guided path from trainer to tested candidate" FontSize="19" FontWeight="SemiBold"/><TextBlock Margin="0,15" Text="1   Connect and detect your running game&#10;&#10;2   Choose an existing trainer and cheat&#10;&#10;3   Search for relocated code and explain the results&#10;&#10;4   Review exact changes, test, and restore if needed&#10;&#10;5   Export with an honest verification record"/>
          <TextBlock Text="Read-only is always the starting point. A generated candidate is never automatically activated or labeled hardware verified." Foreground="{StaticResource AccentBrush}"/></StackPanel>
        </Border>
        <local:ConnectionPanel>
          <local:ConnectionPanel.Style><Style TargetType="local:ConnectionPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SetupStep}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></local:ConnectionPanel.Style>
        </local:ConnectionPanel>
        <TextBlock Text="{Binding ConnectionLabel}" FontWeight="Bold" Margin="0,15,0,5"/><TextBlock Text="{Binding GameLabel}"/><TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="#FFB5AC" Margin="0,10"/>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Back" Command="{Binding SetupBackCommand}"/><Button Content="{Binding SetupNextText}" Command="{Binding SetupNextCommand}" Style="{StaticResource Primary}"/></StackPanel>
  </Grid>
</Window>
